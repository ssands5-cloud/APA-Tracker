# Configure through Vercel environment variables. Never commit actual values.

# Clerk — identity provider
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard

# Turso — application database (authorization, roles, audit log)
# Instance: libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Snapshot encryption key (32-byte AES-256, base64-encoded)
UC_SNAPSHOT_KEY=

# Snapshot storage URL — encrypted blob in Vercel Blob, R2, or S3 (never a git path)
# Set this before production deployment; omit to fall back to local private-snapshots/ file.
UC_SNAPSHOT_URL=

# Removed: UC_AUTHORIZED_EMAILS — replaced by database-backed role system.
# Add users through /dashboard/admin after seeding with src/lib/db/migrate.ts.
