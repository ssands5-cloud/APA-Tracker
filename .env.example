APA_USERNAME=your_username_here
APA_PASSWORD=your_password_here

# ---------------------------------------------------------------------------
# Storage root — set to override the default D:\APA-Tracker-Data.
# All scripts and the refresh pipeline read this to find databases,
# refresh outputs, exports, and historical data.
# Leave unset to use the default.
# ---------------------------------------------------------------------------
# APA_DATA_ROOT=D:\APA-Tracker-Data

# Override the active production database path (optional).
# Defaults to $APA_DATA_ROOT/databases/apa_tracker.db
# APA_DB_PATH=
